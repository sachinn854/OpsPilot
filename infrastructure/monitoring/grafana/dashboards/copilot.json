{
  "title": "AI Operations Copilot",
  "uid": "copilot-main",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Runs / min",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(copilot_runs_total[1m])",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 2,
      "title": "Run Duration (p95)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(copilot_run_duration_seconds_bucket[5m]))",
        "legendFormat": "p95 latency"
      }]
    },
    {
      "id": 3,
      "title": "Pending Approvals",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "copilot_active_approvals",
        "legendFormat": "pending"
      }]
    },
    {
      "id": 4,
      "title": "LLM Tokens / min",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "expr": "rate(copilot_llm_tokens_total[1m])",
        "legendFormat": "{{kind}}"
      }]
    },
    {
      "id": 5,
      "title": "Runs Over Time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(copilot_runs_total[5m])",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 6,
      "title": "Tool Calls by Tool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(copilot_tool_calls_total[5m])",
        "legendFormat": "{{tool_name}}"
      }]
    },
    {
      "id": 7,
      "title": "Run Duration Histogram",
      "type": "histogram",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(copilot_run_duration_seconds_bucket[5m])",
        "legendFormat": "{{le}}"
      }]
    },
    {
      "id": 8,
      "title": "Critic Retries",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(copilot_critic_retries_total[5m])",
        "legendFormat": "retries/min"
      }]
    }
  ]
}
