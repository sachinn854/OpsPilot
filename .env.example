# ============================================================
# AI Operations Copilot — Environment variables (TEMPLATE)
#
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env        (Mac/Linux)
#   copy .env.example .env      (Windows)
#
# NEVER commit the real `.env` — it is gitignored.
# ============================================================

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- OpenRouter (LLM) ---  get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any model from openrouter.ai/models — default: Claude Haiku 4.5 (fast + great tool-calling)
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
# Free model used only for prompt-section classification (which service is the user talking about)
CLASSIFIER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- API authentication ---
# Set a strong random string to protect all endpoints.
# Leave empty to skip validation in development.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# --- GitHub tool ---  github.com → Settings → Developer settings → Personal access tokens
# Can also be set per-user via the Settings page in the frontend (stored encrypted in DB)
GITHUB_TOKEN=your_github_token_here
# GitHub webhook secret — must match what you enter in GitHub repo → Settings → Webhooks
# Slack Bot OAuth token — create a Slack app at https://api.slack.com/apps
# Required scopes: channels:read, channels:write, chat:write, files:write,
#                  groups:read, im:write, mpim:write, search:read, users:read, users:read.email
# Can also be set per-user via the Settings page in the frontend.
SLACK_TOKEN=
# App-Level Token for Socket Mode (xapp-...) — enable Socket Mode in Slack app settings
SLACK_APP_TOKEN=
# Signing Secret — from Slack app Basic Information page (verifies interactive payloads)
SLACK_SIGNING_SECRET=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=

# --- Integration token encryption ---
# Required when users connect services (GitHub, Slack) via the Settings page.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- PostgreSQL ---
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_pass
POSTGRES_DB=copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://copilot:copilot_pass@localhost:5433/copilot

# --- Redis (cache + Celery) ---
REDIS_URL=redis://localhost:6380/0

# --- Qdrant (vector DB) ---
QDRANT_URL=http://localhost:6335
QDRANT_API_KEY=

# --- RAG / embeddings (Phase 2) ---  local embeddings via fastembed (no key/cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
QDRANT_COLLECTION=documents
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_HYBRID=true       # fuse semantic + BM25 keyword search
RAG_RERANK=false      # cross-encoder rerank (off: adds latency; turn on for large KB)

# --- Rate limiting (requests per minute per IP) ---
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_RUNS=10/minute
RATE_LIMIT_APPROVALS=20/minute

# --- MCP tool registry ---
# Comma-separated server names to enable, or "all" to enable everything.
# Available: github, rag, ops, slack, search, monitoring
TOOLS_ENABLED=github,rag,ops,slack,search,monitoring

# --- Email / SMTP (for digest delivery) ---
# Gmail: generate an App Password at myaccount.google.com/apppasswords
# SendGrid: SMTP_HOST=smtp.sendgrid.net  SMTP_USER=apikey  SMTP_PASSWORD=<sendgrid-key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=OpsPilot

# --- LangSmith tracing (optional — leave blank to disable) ---
# Get a free key at https://smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-operations-copilot
